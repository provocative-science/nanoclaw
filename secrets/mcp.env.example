# Copy to secrets/mcp.env (gitignored) and replace placeholders.
# Use single quotes around values that might contain special shell characters.
#
#   cp secrets/mcp.env.example secrets/mcp.env
#   $EDITOR secrets/mcp.env
#   ./scripts/render-mcp.sh
#
# Restart nanoclaw after changing secrets.

# Internal integration secret from https://www.notion.so/my-integrations — connect pages to the integration.
NOTION_TOKEN='ntn_REPLACE_WITH_INTEGRATION_SECRET'

GRAFANA_URL='https://provocativerob.grafana.net'
GRAFANA_SERVICE_ACCOUNT_TOKEN='PASTE_GRAFANA_SERVICE_ACCOUNT_TOKEN_ROTATE_IF_LEAKED'

# Wasabi S3 (S3-compatible) — plant parquet telemetry + console logs.
# Bucket layout: logs/{control|automation}/{telemetry|console}/host={host}/year=/month=/day=/*.parquet
TELEMETRY_S3_ACCESS_KEY='PASTE_WASABI_ACCESS_KEY'
TELEMETRY_S3_SECRET_KEY='PASTE_WASABI_SECRET_KEY'
TELEMETRY_S3_REGION='us-east-1'
TELEMETRY_S3_ENDPOINT='https://s3.us-east-1.wasabisys.com'
TELEMETRY_S3_BUCKET='provocative-dac-dev-beef'
# Comma-separated. When set, this list is what the MCP inventories (beef=airbed nested hive, a7f3=container-ship machine hive).
TELEMETRY_S3_BUCKETS='provocative-dac-dev-beef,provocative-dac-dev-a7f3'
