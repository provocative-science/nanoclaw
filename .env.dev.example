# Dev / non-production NanoClaw instance.
# Copy to .env in nanoclaw-dev (or cloud sandbox). Do NOT copy production .env.
#
# Plant deploy branch: git switch instance/provocative
# Tools-only branch:   git switch main
# Sync tools → instance (merge only): ./scripts/instance-overlay/sync-from-main.sh
# See docs/INSTANCE-OVERLAY.md
#
#   cp .env.dev.example .env
#   # then set NANOCLAW_CONFIG_HOME to an absolute path, e.g.:
#   # NANOCLAW_CONFIG_HOME=/home/YOU/.config/nanoclaw-dev
#
# Never set TELEGRAM_BOT_TOKEN to the production Ghost bot token here.
# Doing so can steal updates from prod or send duplicate replies.

NANOCLAW_INSTANCE=dev
NANOCLAW_ALLOW_NO_CHANNELS=1
NANOCLAW_CONFIG_HOME=/home/co2/.config/nanoclaw-dev
CONTAINER_IMAGE=nanoclaw-agent-dev:latest
ASSISTANT_NAME=GhostDev

# Leave unset (or blank) so Telegram stays off:
# TELEGRAM_BOT_TOKEN=

# Only for a separate BotFather *test* bot + private test chat (never prod groups):
# NANOCLAW_ALLOW_DEV_TELEGRAM=1
# TELEGRAM_BOT_TOKEN=<test-bot-token-only>

# Optional: OneCLI / Anthropic for claw and agent containers (dev credentials preferred)
# ONECLI_URL=http://localhost:10254
