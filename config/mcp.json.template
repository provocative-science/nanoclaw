{
  "mcpServers": {
    "notion": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NODE_USE_ENV_PROXY && npx -y @notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "grafana": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "telemetry": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NODE_USE_ENV_PROXY && python3 /app/telemetry-mcp/server.py"],
      "env": {
        "TELEMETRY_S3_ACCESS_KEY": "${TELEMETRY_S3_ACCESS_KEY}",
        "TELEMETRY_S3_SECRET_KEY": "${TELEMETRY_S3_SECRET_KEY}",
        "TELEMETRY_S3_REGION": "${TELEMETRY_S3_REGION}",
        "TELEMETRY_S3_ENDPOINT": "${TELEMETRY_S3_ENDPOINT}",
        "TELEMETRY_S3_BUCKET": "${TELEMETRY_S3_BUCKET}"
      }
    }
  }
}
